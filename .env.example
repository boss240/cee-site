DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cee_site"

# --- AI провайдери (без них AI-помічник працює на локальній базі знань) ---
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- NextAuth (адмінка) ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Перший адмін (використовується npm run db:seed) ---
SEED_ADMIN_EMAIL="admin@cee.org.ua"
SEED_ADMIN_PASSWORD="change-me"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Сповіщення про заявки (без них заявки просто лягають у БД і видно в адмінці) ---
# Пошта через SMTP: Gmail (пароль застосунку), ukr.net, Zoho, корпоративна — будь-яка.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ЦЕЕ <info@cee.energy>"
# Кому надсилати сповіщення про нові заявки (кілька адрес через кому)
NOTIFY_TO=""
# Telegram: токен від @BotFather і id чату/групи (кілька через кому)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
