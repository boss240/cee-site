# ---- Копіюйте в .env.production (корінь проєкту) і заповніть ----

# Домен сайту (без https://). Caddy отримає сертифікат автоматично.
SITE_DOMAIN=cee.energy
# Повна адреса сайту — вшивається в білд, використовується в листах, sitemap, robots
NEXT_PUBLIC_APP_URL=https://cee.energy

# Пароль до PostgreSQL у контейнері (придумайте довгий випадковий)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# NextAuth (адмінка). Секрет: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=https://cee.energy

# Перший адміністратор (створюється командою db:seed один раз)
SEED_ADMIN_EMAIL=admin@cee.energy
SEED_ADMIN_PASSWORD=change-me-strong-password

# ---- Необов'язково. Без цього все працює, просто без цих каналів ----

# AI-помічник через мовну модель (без ключа — база знань сайту)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Листи: автовідповідь клієнту + сповіщення Центру
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ЦЕЕ <info@cee.energy>
NOTIFY_TO=office@cee.energy

# Telegram-сповіщення про заявки
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# База знань: автоматичне оновлення RSS-стрічок за розкладом.
# Секрет: openssl rand -hex 24. Виклик: curl -H "Authorization: Bearer $CRON_SECRET" https://cee.energy/api/cron/fetch-news
# На Vercel розклад задано у vercel.json, секрет — у змінних середовища проєкту.
CRON_SECRET=
